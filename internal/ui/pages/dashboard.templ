package pages

import (
	"github.com/drywaters/dejaview/internal/model"
	"github.com/drywaters/dejaview/internal/ui/components"
	"github.com/drywaters/dejaview/internal/ui/layout"
	"github.com/drywaters/dejaview/internal/ui"
)

// GroupData holds the data for a movie group
type GroupData struct {
	Number  int
	Entries []*model.Entry
}

templ DashboardPage(groups []GroupData, persons []*model.Person, currentGroup int, isAuthenticated bool) {
	@layout.Base("Dashboard") {
		@layout.Header(isAuthenticated, "movies")

		<main class="page stack-12" id="dashboard-content">
			@DashboardContent(groups, persons, currentGroup, isAuthenticated)
		</main>
	}
}

// DashboardContent renders just the inner content for HTMX partial updates
templ DashboardContent(groups []GroupData, persons []*model.Person, currentGroup int, isAuthenticated bool) {
	<!-- Search Section -->
	<section class="card">
		<h2 class="card-title">
			@components.Icon("search", "text-neon-rose")
			<span>Add movie</span>
		</h2>

		<div class="flex flex-col sm:flex-row sm:items-end gap-4">
			<div class="sm:flex-1">
				<label for="movie-search" class="field-label">Search TMDB</label>
				<input
					type="search"
					id="movie-search"
					name="q"
					placeholder="Search for a movie…"
					class="input-field"
					hx-get="/api/tmdb/search"
					hx-trigger="input changed delay:300ms, search"
					hx-target="#search-results"
					disabled?={ !isAuthenticated }
				/>
			</div>
			<div class="sm:w-56">
				<label for="add-group-select" class="field-label">Add to</label>
				<select name="group_number" id="add-group-select" class="input-field" disabled?={ !isAuthenticated }>
					if len(groups) == 0 {
						<option value="1" selected>Group 1 (new)</option>
					} else {
						for _, group := range groups {
							<option value={ ui.IntToStr(group.Number) } selected?={ group.Number == currentGroup }>
								Group { ui.IntToStr(group.Number) } ({ ui.IntToStr(len(group.Entries)) })
							</option>
						}
						<option value={ ui.IntToStr(currentGroup + 1) }>+ New group</option>
					}
				</select>
			</div>
		</div>

		if !isAuthenticated {
			<p class="muted-note">Log in to add movies or make changes.</p>
		}

		<div id="search-results" class="mt-4"></div>
	</section>

	<!-- Groups Section -->
	if len(groups) == 0 {
		<div class="empty-state">
			@components.Icon("film-reel", "")
			<h2>No movies yet</h2>
			<p>Search for a movie above to start your collection.</p>
		</div>
	} else {
		for _, group := range groups {
			@GroupSection(group.Number, group.Entries, persons, isAuthenticated, group.Number == currentGroup)
		}
	}
}

templ GroupSection(groupNum int, entries []*model.Entry, persons []*model.Person, isAuthenticated bool, isCurrent bool) {
	<section class={ "group-section", templ.KV("is-current", isCurrent) } id={ "group-" + ui.IntToStr(groupNum) }>
		<div class="group-head">
			<h2 class="group-title">
				<span>Group { ui.IntToStr(groupNum) }</span>
			</h2>
			<span class="group-count">
				{ ui.IntToStr(len(entries)) } { pluralize(len(entries), "movie", "movies") }
			</span>
		</div>

		if len(entries) == 0 {
			<p class="text-ink-muted">No movies in this group yet.</p>
		} else {
			<div class="sortable-grid poster-grid" data-group={ ui.IntToStr(groupNum) }>
				for _, entry := range entries {
					if isAuthenticated {
						@components.DraggablePosterCard(entry, true, true)
					} else {
						@components.PosterCard(entry, true)
					}
				}
			</div>
		}
	</section>
}

func pluralize(count int, singular, plural string) string {
	if count == 1 {
		return singular
	}
	return plural
}
