package pages

import (
	"github.com/drywaters/dejaview/internal/ui/layout"
	"github.com/drywaters/dejaview/internal/ui/components"
)

templ LoginPage(errorType string, redirectURL string) {
	@layout.Base("Login") {
		<main class="login-screen">
			<div class="login-card">
				<div class="text-center mb-8">
					@components.Icon("clapperboard-logo", "text-5xl text-neon-rose")
					<p class="osd osd-lg osd-rose mt-4"><span class="osd-blink">&#9654;</span> Press play</p>
					<h1 class="detail-title mt-2">Deja<span class="text-neon-rose">View</span></h1>
					<p class="mt-2 text-ink-muted">Family movie night tracker</p>
				</div>

				if errorType != "" {
					<div class="login-error" role="alert">
						<strong>Can't sign in.</strong>
						if errorType == "missing_key" {
							Enter your access token.
						} else if errorType == "invalid_key" {
							That token didn't work. Try again.
						} else {
							Something went wrong. Try again.
						}
					</div>
				}

				<form action="/login" method="POST" class="space-y-4">
					<input type="hidden" name="redirect" value={ redirectURL }/>

					<div>
						<label for="api_key" class="field-label">Access token</label>
						<input
							type="password"
							id="api_key"
							name="api_key"
							required
							autocomplete="current-password"
							class="input-field"
							placeholder="Enter your token"
						/>
					</div>

					<button type="submit" class="btn-primary w-full">Sign in</button>
				</form>

				<hr class="divider my-8"/>

				<p class="osd osd-dim login-footer">The Waters family collection</p>
			</div>
		</main>
	}
}
