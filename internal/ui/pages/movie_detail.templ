package pages

import (
	"github.com/drywaters/dejaview/internal/model"
	"github.com/drywaters/dejaview/internal/ui"
	"github.com/drywaters/dejaview/internal/ui/components"
	"github.com/drywaters/dejaview/internal/ui/layout"
)

templ MovieDetailPage(entry *model.Entry, persons []*model.Person, isAuthenticated bool) {
	@layout.Base(entry.Movie.Title) {
		@layout.Header(isAuthenticated, "movies")

		<main class="page">
			<a href="/" class="back-link">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
				</svg>
				<span>Back to movies</span>
			</a>

			<div class="detail-grid">
				<!-- Poster Column -->
				<div class="flex flex-col gap-4 min-w-0">
					<div class="detail-poster">
						@components.Poster(entry.Movie, "")
					</div>

					<!-- Group & Actions (after the ratings on phones) -->
					<div class="card hidden lg:flex flex-col gap-4">
						@movieGroupCard(entry, persons, isAuthenticated, "picked-by-desktop")
					</div>
				</div>

				<!-- Details Column -->
				<div class="flex flex-col gap-6 min-w-0">
					<div>
						<h1 class="detail-title">{ entry.Movie.Title }</h1>
						<div class="detail-meta">
							if entry.Movie.ReleaseYear != nil {
								<span>{ ui.IntToStr(*entry.Movie.ReleaseYear) }</span>
							}
							if entry.Movie.RuntimeMinutes != nil {
								<span aria-hidden="true">·</span>
								<span>{ entry.Movie.FormattedRuntime() }</span>
							}
							if entry.PickedByPerson != nil {
								<span aria-hidden="true">·</span>
								<span class="detail-picker">
									<span class={ "picker-badge", entry.PickedByPerson.ColorClass() } aria-hidden="true">{ entry.PickedByPerson.Initial }</span>
									Picked by { entry.PickedByPerson.Name }
								</span>
							}
						</div>
					</div>

					<!-- Ratings Form -->
					<form
						hx-put={ "/api/entries/" + entry.ID.String() + "/ratings" }
						hx-trigger="submit"
						hx-target="#ratings-section"
						hx-swap="outerHTML"
					>
						@ratingsCard(entry, persons, isAuthenticated)
					</form>

					<!-- Synopsis -->
					if entry.Movie.Synopsis != nil && *entry.Movie.Synopsis != "" {
						<section class="card">
							<h2 class="card-title">Synopsis</h2>
							<p class="synopsis-text">{ *entry.Movie.Synopsis }</p>
						</section>
					}

					<div class="card flex flex-col gap-4 lg:hidden">
						@movieGroupCard(entry, persons, isAuthenticated, "picked-by-mobile")
					</div>
				</div>
			</div>
		</main>
	}
}

templ movieGroupCard(entry *model.Entry, persons []*model.Person, isAuthenticated bool, selectID string) {
	<div class="detail-row">
		<span class="text-kicker">Group</span>
		<span class="osd osd-rose">Tape { ui.IntToStr(entry.GroupNumber) }</span>
	</div>

	<div>
		<label for={ selectID } class="field-label">Picked by</label>
		<select
			id={ selectID }
			name="picked_by_person_id"
			hx-put={ "/api/entries/" + entry.ID.String() }
			hx-trigger="change"
			hx-swap="none"
			class="input-field"
			disabled?={ !isAuthenticated }
		>
			<option value="">No one</option>
			for _, person := range persons {
				if entry.PickedByPersonID != nil && *entry.PickedByPersonID == person.ID {
					<option value={ person.ID.String() } selected>{ person.Name }</option>
				} else {
					<option value={ person.ID.String() }>{ person.Name }</option>
				}
			}
		</select>
	</div>

	<button
		hx-delete={ "/api/entries/" + entry.ID.String() }
		hx-confirm="Remove this movie from your collection?"
		hx-swap="none"
		class="btn-danger w-full"
		disabled?={ !isAuthenticated }
	>
		Remove from collection
	</button>
}

// ratingsCard is the ratings card body shared by the page and the save response.
templ ratingsCard(entry *model.Entry, persons []*model.Person, isAuthenticated bool) {
	<div class="card" id="ratings-section">
		if !isAuthenticated {
			<p class="muted-note mt-0 mb-4">Log in to save ratings or edit this movie.</p>
		}
		<fieldset disabled?={ !isAuthenticated }>
			<div class="ratings-head mb-6">
				<h2 class="card-title mb-0">Family ratings</h2>
				<div class="flex flex-wrap items-center gap-3">
					<div id="average-rating">
						@components.AverageRating(entry.AverageRating(), entry.RatingCount())
					</div>
					<button type="submit" class="btn-primary">Save ratings</button>
				</div>
			</div>

			<div class="rating-rows">
				for _, person := range persons {
					@components.PersonRatingRowSimple(entry, person)
				}
			</div>
		</fieldset>
	</div>
}
