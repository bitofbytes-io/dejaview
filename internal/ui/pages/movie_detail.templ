package pages

import (
	"github.com/drywaters/dejaview/internal/model"
	"github.com/drywaters/dejaview/internal/ui"
	"github.com/drywaters/dejaview/internal/ui/components"
	"github.com/drywaters/dejaview/internal/ui/layout"
)

templ MovieDetailPage(entry *model.Entry, persons []*model.Person, isAuthenticated bool) {
	@layout.Base(entry.Movie.Title) {
		@layout.Header(isAuthenticated, "movies")

		<main class="page">
			<a href="/" class="back-link">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
				</svg>
				<span>Back to movies</span>
			</a>

			<div class="detail-grid">
				<!-- Poster column: poster and group card -->
				<div class="detail-col">
					<div class="detail-poster">
						@components.Poster(entry.Movie, "")
					</div>

					<!-- Group & Actions (last on phones) -->
					<div class="detail-group card flex flex-col gap-4">
						@movieGroupCard(entry, persons, isAuthenticated)
					</div>
				</div>

				<!-- Details column: title, ratings, synopsis -->
				<div class="detail-col">
					<div class="detail-head">
						<h1 class="detail-title">{ entry.Movie.Title }</h1>
						<div class="detail-meta">
							if entry.Movie.ReleaseYear != nil {
								<span>{ ui.IntToStr(*entry.Movie.ReleaseYear) }</span>
							}
							if entry.Movie.RuntimeMinutes != nil {
								<span aria-hidden="true">·</span>
								<span>{ entry.Movie.FormattedRuntime() }</span>
							}
							<span id="detail-picker" class="detail-picker" hidden?={ entry.PickedByPerson == nil }>
								if entry.PickedByPerson != nil {
									<span class={ "picker-badge", entry.PickedByPerson.ColorClass() } aria-hidden="true">{ entry.PickedByPerson.Initial }</span>
									<span class="detail-picker-name">Picked by { entry.PickedByPerson.Name }</span>
								} else {
									<span class="picker-badge" aria-hidden="true"></span>
									<span class="detail-picker-name"></span>
								}
							</span>
						</div>
					</div>

					<!-- Ratings Form -->
					<form
						class="detail-ratings"
						hx-put={ "/api/entries/" + entry.ID.String() + "/ratings" }
						hx-trigger="submit"
						hx-target="#ratings-section"
						hx-swap="outerHTML"
					>
						@ratingsCard(entry, persons, isAuthenticated)
					</form>

					<!-- Synopsis -->
					if entry.Movie.Synopsis != nil && *entry.Movie.Synopsis != "" {
						<section class="detail-synopsis card">
							<h2 class="card-title">Synopsis</h2>
							<p class="synopsis-text">{ *entry.Movie.Synopsis }</p>
						</section>
					}
				</div>
			</div>
			@pickerSync()
		</main>
	}
}

templ movieGroupCard(entry *model.Entry, persons []*model.Person, isAuthenticated bool) {
	<div class="detail-row">
		<span class="text-kicker">Group</span>
		<span class="osd osd-rose">Tape { ui.IntToStr(entry.GroupNumber) }</span>
	</div>

	<div>
		<label for="picked-by" class="field-label">Picked by</label>
		<select
			id="picked-by"
			name="picked_by_person_id"
			hx-put={ "/api/entries/" + entry.ID.String() }
			hx-trigger="change"
			hx-swap="none"
			class="input-field"
			disabled?={ !isAuthenticated }
		>
			<option value="">No one</option>
			for _, person := range persons {
				if entry.PickedByPersonID != nil && *entry.PickedByPersonID == person.ID {
					<option value={ person.ID.String() } data-initial={ person.Initial } data-color={ person.ColorClass() } selected>{ person.Name }</option>
				} else {
					<option value={ person.ID.String() } data-initial={ person.Initial } data-color={ person.ColorClass() }>{ person.Name }</option>
				}
			}
		</select>
	</div>

	<button
		hx-delete={ "/api/entries/" + entry.ID.String() }
		hx-confirm="Remove this movie from your collection?"
		hx-swap="none"
		class="btn-danger w-full"
		disabled?={ !isAuthenticated }
	>
		Remove from collection
	</button>
}

// ratingsCard is the ratings card body shared by the page and the save response.
templ ratingsCard(entry *model.Entry, persons []*model.Person, isAuthenticated bool) {
	<div class="card" id="ratings-section">
		if !isAuthenticated {
			<p class="muted-note mt-0 mb-4">Log in to save ratings or edit this movie.</p>
		}
		<fieldset disabled?={ !isAuthenticated }>
			<div class="ratings-head mb-6">
				<h2 class="card-title mb-0">Family ratings</h2>
				<div class="flex flex-wrap items-center gap-3">
					<div id="average-rating">
						@components.AverageRating(entry.AverageRating(), entry.RatingCount())
					</div>
					<button type="submit" class="btn-primary">Save ratings</button>
				</div>
			</div>

			<div class="rating-rows">
				for _, person := range persons {
					@components.PersonRatingRowSimple(entry, person)
				}
			</div>
		</fieldset>
	</div>
}

// pickerSync keeps the "Picked by" line under the title in step with the
// picker select once a change has saved (the request swaps nothing).
templ pickerSync() {
	<script>
		(function () {
			var select = document.getElementById('picked-by');
			var line = document.getElementById('detail-picker');
			if (!select || !line) {
				return;
			}
			select.addEventListener('htmx:afterRequest', function (evt) {
				if (!evt.detail || !evt.detail.successful) {
					return;
				}
				var option = select.options[select.selectedIndex];
				var badge = line.querySelector('.picker-badge');
				var name = line.querySelector('.detail-picker-name');
				if (!option || !option.value) {
					line.hidden = true;
					return;
				}
				badge.className = 'picker-badge ' + (option.dataset.color || '');
				badge.textContent = option.dataset.initial || '';
				name.textContent = 'Picked by ' + option.textContent.trim();
				line.hidden = false;
			});
		})();
	</script>
}
