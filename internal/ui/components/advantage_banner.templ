package components

import (
	"github.com/drywaters/dejaview/internal/model"
	"github.com/drywaters/dejaview/internal/ui"
)

// AdvantageBanner shows who has the next movie-night bonus.
templ AdvantageBanner(holder *model.Person, fromGroup int) {
	if holder != nil {
		<div class={ "advantage-banner", holder.ColorClass() }>
			<div class="advantage-badge" aria-hidden="true">{ holder.Initial }</div>
			<div class="min-w-0">
				<p class="advantage-title">{ holder.Name } has the 3-pick bonus</p>
				<p class="advantage-sub">Group { ui.IntToStr(fromGroup) } unlocked 3 entries in the next draw.</p>
			</div>
			<span class="advantage-tickets" aria-hidden="true">3 × tickets</span>
		</div>
	} else {
		<div class="advantage-banner">
			<div class="advantage-badge" aria-hidden="true">?</div>
			<div class="min-w-0">
				<p class="advantage-title">The bonus is ready to play</p>
				<p class="advantage-sub">Finish the first group to see who gets 3 entries next time.</p>
			</div>
		</div>
	}
}
