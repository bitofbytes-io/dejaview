package components

import (
	"github.com/drywaters/dejaview/internal/model"
	"github.com/drywaters/dejaview/internal/ui"
	"github.com/google/uuid"
)

// RatingInputSimple renders an editable rating input without form wrapper
templ RatingInputSimple(entryID uuid.UUID, person *model.Person, currentScore *float64) {
	<div class="rating-controls">
		<input
			type="number"
			name={ "rating[" + person.ID.String() + "]" }
			data-person-id={ person.ID.String() }
			min="0"
			max="10"
			step="0.5"
			inputmode="decimal"
			oninput="if (this.value === '') { return; } const v = parseFloat(this.value); if (!Number.isNaN(v)) { if (v > 10) { this.value = '10'; } else if (v < 0) { this.value = '0'; } }"
			if currentScore != nil {
				value={ ui.FormatFloat(*currentScore) }
			}
			placeholder="—"
			class="rating-input"
			aria-label={ person.Name + "'s rating" }
		/>
		if currentScore != nil {
			<button
				type="button"
				onclick="this.previousElementSibling.value = ''"
				class="btn-icon rating-clear"
				title="Clear rating"
				aria-label={ "Clear " + person.Name + "'s rating" }
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
				</svg>
			</button>
		}
	</div>
}

// PersonRatingRowSimple renders a rating row without the form wrapper. When
// editable is false the score is shown read-only, with no input or clear button.
templ PersonRatingRowSimple(entry *model.Entry, person *model.Person, editable bool) {
	<div class={ "rating-row", person.ColorClass() }>
		<span class="rating-person min-w-0" title={ person.Name }>
			<span class="initial" aria-hidden="true">{ person.Initial }</span>
			<span class="truncate">{ person.Name }</span>
		</span>
		if editable {
			@RatingInputSimple(entry.ID, person, ui.GetRatingScore(entry, person.ID))
		} else {
			@RatingScore(ui.GetRatingScore(entry, person.ID))
		}
	</div>
}

// RatingScore renders one person's score as a read-only badge.
templ RatingScore(score *float64) {
	if score != nil {
		<span class={ "rating-badge rating-score", model.ScoreColorClass(*score) }>{ ui.FormatFloat(*score) }</span>
	} else {
		<span class="rating-badge rating-score rating-empty">
			<span aria-hidden="true">—</span>
			<span class="sr-only">Not rated</span>
		</span>
	}
}

// AverageRating renders the average rating display; personCount is how many
// people can rate.
templ AverageRating(avg *float64, ratingCount int, personCount int) {
	<div class="ratings-average">
		<span class="text-kicker">Average</span>
		if avg != nil {
			<span class={ "rating-badge rating-badge-lg", model.ScoreColorClass(*avg) }>
				{ ui.FormatFloat(*avg) }
			</span>
			<span class="ratings-count">{ ui.IntToStr(ratingCount) } of { ui.IntToStr(personCount) } rated</span>
		} else {
			<span class="rating-badge rating-badge-lg rating-empty">—</span>
			<span class="ratings-count">No ratings yet</span>
		}
	</div>
}
