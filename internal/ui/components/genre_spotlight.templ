package components

import (
	"fmt"
	"github.com/drywaters/dejaview/internal/model"
	"github.com/drywaters/dejaview/internal/ui"
)

// GenreSpotlight renders the Genre Loyalist trophy, the family's highest-rated
// genre, and each person's most-picked genre.
templ GenreSpotlight(genres model.GenreSpotlight) {
	<div class="trophy-grid">
		@TrophyCard(genres.Loyalist)
		@FamilyFavoriteGenreCard(genres.FamilyFavorite)
		@PickerGenresCard(genres.PickerGenres)
	</div>
}

// FamilyFavoriteGenreCard shows the genre the family rates highest.
templ FamilyFavoriteGenreCard(favorite *model.GenreRating) {
	@trophyCardLayout("star", "Family Favorite Genre", "The genre we rate highest together", familyFavoriteValue(favorite), false) {
		if favorite != nil {
			<span class="trophy-winner genre-pill">{ favorite.Genre }</span>
		} else {
			@pendingWinner("Still up for grabs")
		}
	}
}

func familyFavoriteValue(favorite *model.GenreRating) string {
	if favorite == nil {
		return "Waiting for family-rated movies in one genre"
	}
	return fmt.Sprintf("%.1f family average over %d movies", favorite.AverageRating, favorite.Movies)
}

// PickerGenresCard lists the genre each person picks most often.
templ PickerGenresCard(pickerGenres []model.PickerGenre) {
	@trophyCardLayout("popcorn", "Go-To Genres", "The genre each picker reaches for most", "Counts picks per genre; movies can have several", true) {
		if len(pickerGenres) > 0 {
			for _, pick := range pickerGenres {
				<span class={ "trophy-winner", pick.Person.ColorClass() }>
					<span class="trophy-winner-badge" aria-hidden="true">{ pick.Person.Initial }</span>
					<span class="trophy-winner-label">{ pick.Person.Name }: { pick.Genre } ({ ui.IntToStr(pick.Picks) })</span>
				</span>
			}
		} else {
			@pendingWinner("No genres yet")
		}
	}
}
