# Copy this file to local.mk and fill in your values
# local.mk is gitignored

export DATABASE_URL=postgres://user:password@localhost:5432/dejaview?sslmode=disable
# Generate with: openssl rand -base64 32
export API_TOKEN=your-secret-token-here
# Use the API Read Access Token (not the API key) from https://www.themoviedb.org/settings/api
export TMDB_READ_ACCESS_TOKEN=your-tmdb-read-access-token
export PORT=4600
export LOG_LEVEL=debug
# Set to false for local HTTP dev, defaults to true for production HTTPS
export SECURE_COOKIES=false

